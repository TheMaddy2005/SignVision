{
  "version": 2,
  "routes": [
    { "src": "/health",             "dest": "/app.py" },
    { "src": "/api/mapping",        "dest": "/app.py" },
    { "src": "/api/translate",      "dest": "/app.py" },
    { "src": "/api/speech-to-text", "dest": "/app.py" },
    { "src": "/signs/(.*)",         "dest": "/public/signs/$1" },
    { "src": "/(.*)",               "dest": "/public/index.html" }
  ]
}
