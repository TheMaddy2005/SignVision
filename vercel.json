{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "/app.py"
    },
    {
      "src": "/api/mapping",
      "dest": "/app.py"
    },
    {
      "src": "/api/translate",
      "dest": "/app.py"
    },
    {
      "src": "/api/speech-to-text",
      "dest": "/app.py"
    },
    {
      "src": "/signs/alphabets/(.*)",
      "dest": "/public/signs/alphabets/$1"
    },
    {
      "src": "/signs/numbers/(.*)",
      "dest": "/public/signs/numbers/$1"
    },
    {
      "src": "/signs/words/(.*)",
      "dest": "/public/signs/words/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
