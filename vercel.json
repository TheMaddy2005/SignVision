{
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/health",
      "dest": "app.py"
    },
    {
      "src": "/api/mapping",
      "dest": "app.py"
    },
    {
      "src": "/api/translate",
      "dest": "app.py"
    },
    {
      "src": "/api/speech-to-text",
      "dest": "app.py"
    },
    {
      "src": "/signs/(.*)",
      "dest": "/public/signs/$1"
    },
    {
      "src": "/(.*\\.(svg|png|jpg|jpeg|gif|ico|css|js))",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/index.html"
    }
  ]
}
